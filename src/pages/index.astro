---
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LLM Generated Blog</title>
  </head>
  <body style="max-width: 800px; margin: 0 auto; padding: 20px; font-family: sans-serif; line-height: 1.6;">
    <h1>ローカルLLM ブログ</h1>
    <ul>
      {posts.map(post => (
        <li style="margin-bottom: 10px;">
          <a href={`${import.meta.env.BASE_URL}/blog/${post.id}/`}>
            {post.data.title} ({post.data.pubDate.toLocaleDateString('ja-JP')})
          </a>
        </li>
      ))}
    </ul>
  </body>
</html>
